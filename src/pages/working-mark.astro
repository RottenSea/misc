---
import Page from "../layouts/Page.astro";
import {
  ACTIONS,
  CYCLE,
  type Phase,
  type Step,
  sequence
} from "../scripts/working-mark.ts";

// The grid's rows: each phase on its own, then a whole run with two loops.
const ROWS: { label: string; phases: Phase[] }[] = [
  { label: "in", phases: ["in"] },
  { label: "loop", phases: ["loop"] },
  { label: "out", phases: ["out"] },
  { label: "in + loop × 2 + out", phases: ["in", "loop", "loop", "out"] }
];

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const sprites = `${base}working-mark/`;
const steps = (list: Step[]) => JSON.stringify(list);
---

<Page
  title="Working mark"
  description="Six working states, each with an entrance, a loop and an exit."
>
  <h1>Working mark</h1>
  <div
    class="grid"
    data-sprites={sprites}
  >
    <span></span>
    {ACTIONS.map((action) => <span class="label">{action}</span>)}
    {
      ROWS.map(({ label, phases }) => (
        <>
          <span class="label label--row">{label}</span>
          {ACTIONS.map((action) => (
            <span
              class="mark"
              role="img"
              aria-label={`${action}, ${label}`}
              data-steps={steps(sequence(action, phases))}
            >
              <span class="strip" />
            </span>
          ))}
        </>
      ))
    }
  </div>
  <figure class="cycle">
    <span
      class="mark mark--large"
      role="img"
      aria-label="Every state in turn"
      data-steps={steps(CYCLE)}
      data-cycle
    >
      <span class="strip"></span>
    </span>
    <figcaption
      class="label"
      data-name
    >
      {CYCLE[0].action}
    </figcaption>
  </figure>
</Page>

<script>
  import { frameAt, frames, type Step, sprite } from "../scripts/working-mark.ts";

  const grid = document.querySelector<HTMLElement>("[data-sprites]");
  const folder = grid?.dataset.sprites ?? "";
  const name = document.querySelector<HTMLElement>("[data-name]");

  interface Mark {
    host: HTMLElement;
    strip: HTMLElement;
    steps: Step[];
    shown: Step | null;
    cycle: boolean;
  }

  const marks: Mark[] = [...document.querySelectorAll<HTMLElement>("[data-steps]")].map((host) => ({
    host,
    strip: host.querySelector<HTMLElement>(".strip") as HTMLElement,
    steps: JSON.parse(host.dataset.steps ?? "[]"),
    shown: null,
    cycle: host.hasAttribute("data-cycle")
  }));

  const draw = (mark: Mark, step: Step, frame: number) => {
    if (mark.shown !== step) {
      // A new strip: its image as the mask, and tall enough for all its frames.
      mark.shown = step;
      mark.strip.style.maskImage = `url("${folder}${sprite(step)}")`;
      mark.strip.style.height = `${frames(step) * 100}%`;
      if (mark.cycle && name) name.textContent = step.action;
    }
    mark.strip.style.transform = `translateY(${(-frame * 100) / frames(step)}%)`;
  };

  // Every strip is decoded first, so no mark blinks empty the first time its strip changes. The
  // animation is what the page shows, so it plays even when the system asks for reduced motion.
  const files = new Set(marks.flatMap((mark) => mark.steps.map(sprite)));
  Promise.all(
    [...files].map((file) => {
      const image = new Image();
      image.src = `${folder}${file}`;
      return image.decode().catch(() => undefined);
    })
  ).then(() => {
    const start = performance.now();
    const tick = (now: number) => {
      for (const mark of marks) {
        const { step, frame } = frameAt(mark.steps, now - start);
        draw(mark, step, frame);
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>

<style>
  h1 {
    font: var(--display-md-weight) var(--display-md-size) / var(--display-md-lh) var(--display-md-family);
    letter-spacing: var(--display-md-ls);
    color: var(--text-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: auto repeat(6, auto);
    gap: var(--space-lg) var(--space-xl);
    align-items: center;
    justify-items: center;
    max-width: 100%;
    overflow-x: auto;
  }

  .label {
    font: var(--caption-upper-weight) var(--caption-upper-size) / var(--caption-upper-lh) var(--caption-upper-family);
    letter-spacing: var(--caption-upper-ls);
    text-transform: uppercase;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .label--row {
    justify-self: end;
    text-align: right;
  }

  /* The window one frame tall; the strip behind it moves up a frame at a time. */
  .mark {
    display: block;
    width: 3rem;
    height: 3rem;
    overflow: clip;
    color: var(--color-primary);
    user-select: none;
  }

  .mark--large {
    width: 3.75rem;
    height: 3.75rem;
  }

  /* The sprite is a mask, so the mark takes the theme's colour instead of the colour it was drawn in. */
  .strip {
    display: block;
    width: 100%;
    background: currentColor;
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    will-change: transform;
  }

  .cycle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
</style>
