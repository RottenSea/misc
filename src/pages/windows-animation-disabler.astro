---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import Button from "@rottensea/ds-personal-website/components/buttons/Button.astro";
import { rehypeDsExternalLinks } from "@rottensea/ds-personal-website/markdown";
import source from "../../public/windows-animation-disabler/windows-animation-disabler.wh.cpp?raw";
import Page from "../layouts/Page.astro";
import {
  describeValue,
  parseMod,
  type Setting
} from "../scripts/windhawk-mod.ts";

// Everything about the mod comes from its source in public/, which is also the file the page offers
// for download, so the page can't drift from what people install.
const { metadata, readme, settings } = parseMod(source);
const one = (key: string) => metadata[key]?.[0] ?? "";
const id = one("id");
const name = one("name");

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const file = `${id}.wh.cpp`;
const download = `${base}${id}/${file}`;
// Button types its attributes as a button's, which have no `download`, so it goes in through a spread.
const saveAs: Record<string, string> = { download: file };

// The readme without its title, which the page has already, split so that the settings and the
// install steps come before the credits.
const body = readme.replace(/^# .*\r?\n/, "");
const [about, credits = ""] = body.split(/^(?=## Sources)/m);
const markdown = await createMarkdownProcessor({
  rehypePlugins: [[rehypeDsExternalLinks, { site: Astro.site?.href }]]
});
const render = async (text: string) => (await markdown.render(text)).code;
const aboutHtml = await render(about);
const creditsHtml = await render(credits);

// A group's options, or the setting itself when it stands alone.
const options = (setting: Setting) =>
  setting.children.length ? setting.children : [setting];
---

<Page
  title={name}
  description={one("description")}
  top
>
  <article>
    <header class="intro">
      <h1>{name}</h1>
      <p class="lede">{one("description")}.</p>
      <p class="meta">
        Windhawk mod · version {one("version")} · {one("license")} license
      </p>
      <Button
        href={download}
        {...saveAs}
        iconLeft="download"
      >
        Download {file}
      </Button>
    </header>

    <div
      class="prose"
      set:html={aboutHtml}
    />

    <section class="prose">
      <h2>Settings</h2>
      <p>Every option below shows its default. Change them on the mod's Settings tab in Windhawk.</p>
      {
        settings.map((group) => (
          <section class="group">
            <h3>{group.name ?? group.key}</h3>
            {group.children.length > 0 && group.description && <p>{group.description}</p>}
            <dl>
              {options(group).map((option) => (
                <div class="option">
                  <dt>
                    <span>{option.name ?? option.key}</span>
                    {option.value !== undefined && (
                      <span class="default">{describeValue(option.value)}</span>
                    )}
                  </dt>
                  {option.description && <dd>{option.description}</dd>}
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </section>

    <section class="prose">
      <h2>Install</h2>
      <p>The mod isn't in the Windhawk catalogue, so it goes in as your own mod:</p>
      <ol>
        <li>Install <a href="https://windhawk.net/">Windhawk</a> and open it.</li>
        <li>Download <code>{file}</code> with the button above.</li>
        <li>Click <strong>Create a new mod</strong>, select all of the template code in the editor and replace it with the contents of the file.</li>
        <li>Click <strong>Compile mod</strong> (Ctrl+B), then <strong>Exit editing mode</strong>.</li>
      </ol>
      <p>The mod loads into {metadata.include?.map((process, index) => <>{index > 0 && ", "}<code>{process}</code></>)}, on {one("architecture")} only.</p>
    </section>

    <div
      class="prose"
      set:html={creditsHtml}
    />
  </article>
</Page>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: min(100%, var(--container-reading));
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  h1 {
    font: var(--display-md-weight) var(--display-md-size) / var(--display-md-lh) var(--display-md-family);
    letter-spacing: var(--display-md-ls);
    color: var(--text-ink);
  }

  .lede {
    font: var(--title-sm-weight) var(--title-sm-size) / var(--title-sm-lh) var(--title-sm-family);
    color: var(--text-body-strong);
  }

  .meta {
    margin-bottom: var(--space-xs);
    font: var(--caption-weight) var(--caption-size) / var(--caption-lh) var(--caption-family);
    color: var(--text-muted);
  }

  /* The reset strips every default, so the readme's Markdown and the sections below get theirs here. */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font: var(--body-md-weight) var(--body-md-size) / var(--body-md-lh) var(--body-md-family);
  }

  .prose :global(h2) {
    margin-top: var(--space-md);
    font: var(--title-lg-weight) var(--title-lg-size) / var(--title-lg-lh) var(--title-lg-family);
    color: var(--text-ink);
  }

  .prose :global(h3) {
    font: var(--title-md-weight) var(--title-md-size) / var(--title-md-lh) var(--title-md-family);
    color: var(--text-ink);
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-left: 1.5em;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(a) {
    color: var(--text-link);
    text-underline-offset: 0.2em;
  }

  .prose :global(strong) {
    color: var(--text-body-strong);
    font-weight: 600;
  }

  .prose :global(code) {
    font: var(--code-weight) var(--code-size) / var(--code-lh) var(--code-family);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-xs);
    background: var(--surface-code);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  dl {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .option {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
    padding: var(--space-sm) var(--space-md);
  }

  .option + .option {
    border-top: 1px solid var(--hairline-soft);
  }

  dt {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    color: var(--text-ink);
    font-weight: 500;
  }

  .default {
    flex: none;
    font: var(--caption-upper-weight) var(--caption-upper-size) / var(--caption-upper-lh) var(--caption-upper-family);
    letter-spacing: var(--caption-upper-ls);
    text-transform: uppercase;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  dd {
    font: var(--body-sm-weight) var(--body-sm-size) / var(--body-sm-lh) var(--body-sm-family);
    color: var(--text-muted);
  }
</style>
